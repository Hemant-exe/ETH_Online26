# Proof of Heart — environment reference
#
# Copy to .env.local and fill in. Every integration degrades to a clearly
# labelled sandbox path when its variables are absent, so the app runs and
# demos with this file entirely blank — it just cannot make real proofs or
# real payments.

# ---------------------------------------------------------------------------
# World ID — Selfie Check
# ---------------------------------------------------------------------------
# From https://developer.world.org. Selfie Check (credential 11) must be
# enabled for your app by a World contact before it can be requested.
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
# Nullifiers are scoped per (action, person). Changing this makes every
# existing verified user look like a new person.
NEXT_PUBLIC_WORLD_ACTION_ID=proof-of-heart-signup
# The credential preset the widget requests. The Selfie Check docs do not
# publish this string — see FEEDBACK.md. Whatever is set here, the server
# still enforces issuer_schema_id === 11.
NEXT_PUBLIC_WORLD_CREDENTIAL_PRESET=selfieCheck
# Server-only. Signs the IDKit request context. Never expose this.
WORLD_RP_SIGNING_KEY=
WORLD_API_KEY=

# ---------------------------------------------------------------------------
# World AgentKit / AgentBook
# ---------------------------------------------------------------------------
# CAIP-2 chain the agent signer identifies on. World Chain mainnet.
WORLD_AGENT_CHAIN_ID=eip155:480

# ---------------------------------------------------------------------------
# Hedera
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HEDERA_NETWORK=testnet
# Operator account, from https://portal.hedera.com. Creates the receipt topic
# and submits receipts. Server-only.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Created by `npm run hedera:create-topic`.
NEXT_PUBLIC_HCS_RECEIPT_TOPIC_ID=

# ---------------------------------------------------------------------------
# x402 payments
# ---------------------------------------------------------------------------
# Blocky402 serves hedera:testnet and hedera:mainnet.
# https://x402.org/facilitator is a drop-in alternative for testnet.
X402_FACILITATOR_URL=https://api.blocky402.com
# Hedera account that receives inference payments.
X402_PAY_TO_ACCOUNT=
# The paying side: the account twins spend from. ECDSA key, 0x-prefixed.
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=

# Metered pricing. Total = base + prompt tokens + requested output tokens.
TWIN_INFERENCE_PRICE_HBAR=0.01
TWIN_INFERENCE_PROMPT_HBAR_PER_1K=0.004
TWIN_INFERENCE_COMPLETION_HBAR_PER_1K=0.02

# ---------------------------------------------------------------------------
# Inference
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=claude-opus-5
# Only set for a proxy or gateway; leave blank for the Anthropic API.
LLM_BASE_URL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Required in production: server-side paid calls need an absolute URL to
# reach the app's own route handlers.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Profile NFT (Unichain Sepolia) — unchanged from the pre-existing build
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x968Cd0A56cAc23332c846957064A99Eabbdc464E
NEXT_PUBLIC_UNICHAIN_RPC_URL=https://sepolia.unichain.org
NEXT_PUBLIC_LOGO_URL=
